# Copy this file to .env.local for local work. Never commit .env.local.
# Every value here is also set in the Vercel project (Settings -> Environment variables).

# --- Public address -----------------------------------------------------------
# The one place the public base URL lives. It is baked into QR codes and NFC
# links, so changing it (for example to a custom domain) is a single edit here.
# No trailing slash.
PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# From the Supabase dashboard: Project settings -> API keys.
# The URL and publishable key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The secret key bypasses Row Level Security. It is only ever read from
# server-only modules (lib/supabase/admin.ts) and the seed scripts.
SUPABASE_SECRET_KEY=sb_secret_...

# Project ref (the part before .supabase.co) used by `supabase link`.
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# --- Tap logging --------------------------------------------------------------
# Mixed into the daily visitor hash so taps cannot be traced back to an IP.
# Any long random string; rotate it whenever you like (docs/06-operations.md).
VISITOR_HASH_SALT=change-me-to-a-long-random-string

# --- Demo logins (used by `npm run seed:demo` only) ---------------------------
# Passwords must be at least 8 characters. Email addresses can be anything;
# they never receive mail. Change them before any real pilot.
DEMO_ADMIN_EMAIL=admin@tapreview.demo
DEMO_ADMIN_PASSWORD=
DEMO_AREA_MANAGER_EMAIL=area1@tapreview.demo
DEMO_AREA_MANAGER_PASSWORD=
DEMO_BUREAU_MANAGER_EMAIL=westbridgford@tapreview.demo
DEMO_BUREAU_MANAGER_PASSWORD=
DEMO_STAFF_EMAIL=staff@tapreview.demo
DEMO_STAFF_PASSWORD=

# The physical card's store. The seed creates one real (non-demo) tag here.
REAL_STORE_PLACE_ID=ChIJN1CJGPXDeUgRessfZdzwNVY
